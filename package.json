{
  "name": "mak-panel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MUNDO ACTIVATION KEY (MAK/1) control plane — Cloudflare Worker + D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute panel --file=schema.sql",
