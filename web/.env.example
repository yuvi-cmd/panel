# Copy to .env.local and fill in.
# Absolute URL of the Cloudflare Worker (no trailing slash), e.g.:
#   NEXT_PUBLIC_API_BASE=https://sdk-panel.<account>.workers.dev
# Same-domain deployments behind a rewrite can use a path prefix instead.
NEXT_PUBLIC_API_BASE=http://localhost:8787

# Display name fallback when the panel has no custom branding yet.
NEXT_PUBLIC_PANEL_NAME=ARC Auth
